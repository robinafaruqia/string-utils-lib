{
  "name": "stringloom",
  "version": "1.0.0",
  "description": "A lightweight collection of handy string manipulation utilities — slugify, truncate, capitalize, camelToKebab, maskEmail, and more.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "string",
    "utils",
    "utilities",
    "slugify",
    "truncate",
    "capitalize",
    "camelCase",
    "kebab-case",
    "mask",
    "email",
    "lightweight",
    "typescript"
  ],
  "author": "Robina Khan",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^25.3.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "sideEffects": false,
  "homepage": "https://www.npmjs.com/package/stringloom",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robinafaruqia/string-utils-lib.git"
  },
  "bugs": {
    "url": "https://github.com/robinafaruqia/string-utils-lib/issues"
  }
}
